---
import { giscusConfig } from "../../config";

// 渲染为 data-* 属性交给 giscus 的 client.js（theme 在运行时按当前明暗模式决定）
const attrs = {
	repo: giscusConfig.repo,
	"repo-id": giscusConfig.repoId,
	category: giscusConfig.category,
	"category-id": giscusConfig.categoryId,
	mapping: "pathname",
	strict: "0",
	"reactions-enabled": "1",
	"emit-metadata": "0",
	"input-position": "top",
	lang: giscusConfig.lang,
	loading: "lazy",
};
---
{giscusConfig.enable && (
<div id="giscus-container" class="card-base z-10 px-6 md:px-9 py-6 mb-4 w-full rounded-[var(--radius-large)]">
    <div class="giscus"></div>
    <!-- 主题用 swup 做页面切换，它会在每次切换后重新执行页面里的 inline 脚本，所以这里要能重复执行 -->
    <script is:inline define:vars={{ attrs }}>
        const host = document.querySelector("#giscus-container .giscus");
        const currentTheme = () =>
            document.documentElement.classList.contains("dark") ? "dark" : "light";

        if (host && !host.dataset.loaded) {
            host.dataset.loaded = "1";
            const s = document.createElement("script");
            s.src = "https://giscus.app/client.js";
            s.async = true;
            s.crossOrigin = "anonymous";
            for (const [k, v] of Object.entries({ ...attrs, theme: currentTheme() })) {
                s.setAttribute(`data-${k}`, v);
            }
            host.after(s);
        }

        // 读者切换明暗模式时同步给 giscus iframe；整个页面生命周期只挂一个观察者
        if (!window.__giscusThemeObserver) {
            let last = currentTheme();
            window.__giscusThemeObserver = new MutationObserver(() => {
                const theme = currentTheme();
                if (theme === last) return;
                last = theme;
                const frame = document.querySelector("iframe.giscus-frame");
                frame?.contentWindow?.postMessage(
                    { giscus: { setConfig: { theme } } },
                    "https://giscus.app",
                );
            });
            window.__giscusThemeObserver.observe(document.documentElement, {
                attributes: true,
                attributeFilter: ["class"],
            });
        }
    </script>
</div>
)}
